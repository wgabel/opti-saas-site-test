{
  "name": "optimizely-headless-starter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cms:login": "optimizely-cms-cli login",
    "cms:push": "optimizely-cms-cli config push optimizely.config.mjs",
    "cms:push:dry": "optimizely-cms-cli config push optimizely.config.mjs --dryRun",
    "webhook:create": "node scripts/create-webhook.mjs",
    "webhook:list": "node scripts/create-webhook.mjs --list"
  },
  "dependencies": {
    "@optimizely/cms-sdk": "3.0.2",
    "next": "16.3.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@optimizely/cms-cli": "3.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.5.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
